<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">다이나믹 아일랜드</string>
    <string name="xposed_description">ColorOS / HyperOS 스타일의 다이나믹 아일랜드: One UI의 Now Bar 상태바 캡슐을 대체합니다.</string>
    <string name="settings_hint">LSPosed에서 시스템 UI에 모듈을 활성화하세요. 변경 사항은 몇 초 안에 적용됩니다.</string>
    <string name="setting_card_header">카드 헤더</string>
    <string name="setting_card_header_desc">라이브 알림 카드 위에 앱 이름과 시간을 표시합니다.</string>
    <string name="setting_visualizer">오디오 파형</string>
    <string name="setting_visualizer_desc">음악 파형을 실제 오디오 출력으로 구동합니다. 끄면 부드러운 애니메이션을 사용합니다.</string>
    <string name="setting_paused_timeout">일시정지된 음악 유지 시간</string>
    <string name="setting_auto_collapse">확장된 아일랜드 자동 접힘</string>
    <string name="setting_event_charging">충전 / 배터리 부족</string>
    <string name="setting_event_charging_desc">충전기를 연결하거나 배터리가 부족할 때 알려줍니다.</string>
    <string name="setting_event_ringer">소리 모드</string>
    <string name="setting_event_ringer_desc">소리 모드가 바뀌면 무음 / 진동 / 소리를 표시합니다.</string>
    <string name="setting_event_bluetooth">블루투스 오디오</string>
    <string name="setting_event_bluetooth_desc">이어폰, 스피커가 연결되면 배터리 잔량과 함께 표시합니다.</string>
    <string name="setting_haptics">햅틱 피드백</string>
    <string name="setting_haptics_desc">아일랜드가 펼쳐지거나 접힐 때, 버튼을 누를 때 가볍게 진동합니다.</string>
    <string name="setting_privacy">카메라·마이크 사용 알림</string>
    <string name="setting_privacy_desc">어떤 앱이 카메라나 마이크를 쓰는지 보여주고, 누르면 해당 앱의 권한 설정으로 이동합니다.</string>
    <string name="setting_privacy_location">위치 사용 알림</string>
    <string name="setting_privacy_location_desc">위치 사용도 알립니다. 내비게이션과 날씨 앱이 계속 쓰므로 기본은 꺼짐입니다.</string>
    <string name="setting_event_toggles">설정 변경 알림</string>
    <string name="setting_event_toggles_desc">방해금지, 비행기 모드, 절전 모드, 손전등, 핫스팟, 자동 회전이 켜지거나 꺼질 때 알려줍니다.</string>
    <string name="setting_progress">다운로드·전송 진행</string>
    <string name="setting_hide_progress">진행 알림 원본 숨기기</string>
    <string name="setting_hide_progress_desc">섬에 진행 카드가 떠 있는 동안 알림창의 같은 알림을 숨깁니다. 버튼은 카드에 그대로 있습니다.</string>
    <string name="setting_progress_desc">진행률이 있는 알림(다운로드, 파일 복사, 앱 업데이트)을 카드로 보여줍니다.</string>
    <string name="setting_heads_up">알림을 아일랜드로</string>
    <string name="setting_heads_up_desc">메시지 등 상단 배너 알림을 기본 배너 대신 아일랜드 카드로 보여줍니다. 전화와 알람은 기본 배너를 유지합니다.</string>
    <string name="setting_otp">인증번호 카드</string>
    <string name="setting_otp_desc">인증번호가 담긴 문자가 오면 번호와 복사 버튼이 있는 카드를 보여줍니다.</string>
    <string name="setting_otp_copy">인증번호 자동 복사</string>
    <string name="setting_otp_copy_desc">카드가 뜨는 즉시 번호를 클립보드에 복사합니다. 이전에 복사해 둔 내용은 바뀝니다.</string>
    <string name="setting_calls">음성 채팅 통화</string>
    <string name="setting_calls_desc">음성 채팅·인터넷 전화 앱의 진행 중인 통화를 통화 시간과 종료 버튼이 있는 통화 카드로 보여줍니다.</string>
    <string name="restart_systemui">시스템 UI 재시작</string>
    <string name="restart_systemui_confirm">상태바와 알림창이 잠깐 다시 시작되며 모듈이 새로 적용됩니다. 루트 권한이 필요합니다.</string>
    <string name="restart_systemui_failed">시스템 UI를 재시작하지 못했습니다. 루트 권한이 허용되지 않았습니다. LSPosed 관리자에서 재시작하거나 재부팅하세요.</string>
    <string name="rules_title">규칙</string>
    <string name="rules_about">알림이 무슨 뜻인지(배달, 택시, 길안내, 기기 연결, 인증번호) 알려 주는 단어와 패턴이에요. LiveBridge 사전과 같은 파일 형식이에요.</string>
    <string name="setting_smart_rules">배달·택시·길안내·기기 연결 카드</string>
    <string name="setting_smart_rules_desc">"라이더님이 곧 도착해요" 같은 알림을 단계가 보이는 카드로 만듭니다.</string>
